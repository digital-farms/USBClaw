# Models (too large for git, downloaded via menu)
Files/models/*.gguf

# RAG index (generated at runtime)
Files/data/index/*
!Files/data/index/.gitkeep

# Python cache
__pycache__/
*.pyc

# Portable Python (embeddable distribution, downloaded via menu)
Files/python/

# Temp directory (kept on USB, not on host)
Files/tmp/

# Browser/chat profile directory (will be added with sterile-mode feature)
Files/data/chats/*
!Files/data/chats/.gitkeep

# OS junk
Thumbs.db
.DS_Store
desktop.ini
